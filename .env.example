# Copy to .env.local for local development. Demo mode works with NO keys set.
# Meta Model API (Muse Spark, hosted) — see README for where to get a key.
META_MODEL_API_KEY=
# Optional overrides; defaults are the OpenAI-compatible Meta Model API shape.
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_SPARK_MODEL=muse-spark-1.3
META_IMAGE_MODEL=Muse-Image
# Open-weights path via an inference partner (Baseten Model APIs by default).
# This is the path that qualifies for the "Best Build on Meta Open Weight
# Models" bonus, which is verified by the inference partner. Without
# META_OPEN_API_KEY the app uses keyword tags and the demo still works.
META_OPEN_API_BASE_URL=https://inference.baseten.co/v1
META_OPEN_API_KEY=
META_OPEN_MODEL=meta-models/muse-spark-open-1026
# Optional fast-model slot (e.g. a partner-served Muse Glimmer) for feed
# ranking/tagging. Leave blank to use the Muse Spark Open tagging path.
# Set only to a model ID your inference partner actually serves — do not guess one.
META_FAST_MODEL=
# Optional Postgres + pgvector. Leave unset to use the seeded in-memory demo store.
DATABASE_URL=

# Facebook / Instagram live sources (optional).
# A Meta Graph API user access token with instagram_basic and
# pages_read_engagement, from an account with a connected Instagram
# business/creator account. Without it, the Predictor shows seeded
# sources only and social reads "not connected". Never commit a token.
META_GRAPH_TOKEN=<redacted>
